# CyberShield Platform Environment Configuration
# Copy this file to .env for local development

# Flask Secret Key for session signing
SECRET_KEY=cybershield-final-year-project-secret-2026

# Model selection ('logistic_regression', 'svm', or 'distilbert')
MODEL_TYPE=logistic_regression

# MongoDB Connection String (defaults to local MongoDB if not set)
# For local development:
MONGO_URI=mongodb://localhost:27017/
# For cloud deployment (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xixzguw.mongodb.net/cybershield_db?retryWrites=true&w=majority

MONGO_DB_NAME=cybershield_db

# Flask Server Port & Host
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
FLASK_DEBUG=False
